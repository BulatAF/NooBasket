<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingTopicPage"
             x:Name="PageRoot"
             Title="Тестирование"
             NavigationPage.HasBackButton="False">

    <ScrollView>
        <VerticalStackLayout Spacing="8" Padding="8">

            <!-- кнопка назад с всплывающим окном -->
            <Button Text="Назад"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"/>

            <!-- заголовок темы -->
            <Label Text="{Binding Title}" 
                   FontSize="22" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,4"/>

            <!-- номер текущего вопроса -->
            <Label Text="{Binding CurrentQuestionNumber, StringFormat='Вопрос {0}'}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   Margin="0,0,0,8"/>

            <!-- текст вопроса -->
            <Label Text="{Binding QuestionText}" 
                   FontSize="18"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,8"/>

            <!-- картинка к вопросу -->
            <Image Source="{Binding QuestionImage}" 
                   HeightRequest="180" 
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsImageVisible}"
                   Margin="0,0,0,8"/>

            <!-- варианты ответов -->
            <Button Text="{Binding AnswerOptions[0]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[0]}"
                    BackgroundColor="{Binding Answer0Color}"
                    TextColor="{Binding Answer0TextColor}"
                    MinimumHeightRequest="50"
                    LineBreakMode="WordWrap"
                    Margin="0,4"/>

            <Button Text="{Binding AnswerOptions[1]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[1]}"
                    BackgroundColor="{Binding Answer1Color}"
                    TextColor="{Binding Answer1TextColor}"
                    MinimumHeightRequest="50"
                    LineBreakMode="WordWrap"
                    Margin="0,4"/>

            <Button Text="{Binding AnswerOptions[2]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[2]}"
                    BackgroundColor="{Binding Answer2Color}"
                    TextColor="{Binding Answer2TextColor}"
                    MinimumHeightRequest="50"
                    LineBreakMode="WordWrap"
                    Margin="0,4"/>

            <Button Text="{Binding AnswerOptions[3]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[3]}"
                    BackgroundColor="{Binding Answer3Color}"
                    TextColor="{Binding Answer3TextColor}"
                    MinimumHeightRequest="50"
                    LineBreakMode="WordWrap"
                    Margin="0,4"/>

            <!-- объяснение ответа -->
            <Label Text="{Binding AnswerExplanation}" 
                   FontSize="14"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   Margin="0,8,0,8"/>

            <!-- кнопка "Следующая" или "Завершить" -->
            <Button Text="{Binding NextButtonText}"
                    Command="{Binding NextQuestionCommand}"
                    HorizontalOptions="Fill"
                    Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
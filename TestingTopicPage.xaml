<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingTopicPage"
             x:Name="PageRoot"
             Title="Тестирование"
             NavigationPage.HasBackButton="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="10" HorizontalOptions="Center">

            <!--заголовок темы-->
            <Label Text="{Binding Title}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!--номер текущего вопроса из общего количества -->
            <!--StringFormat='Вопрос {0}' подставляет значение CurrentQuestionNumber вместо {0}-->
            <Label Text="{Binding CurrentQuestionNumber, StringFormat='Вопрос {0}'}"
                   HorizontalOptions="Center"
                   FontSize="16"/>

            <!--текст самого вопроса -->
            <Label Text="{Binding QuestionText}" 
                   FontSize="20"
                   HorizontalOptions="Center"
                   Margin="10"/>

            <!--картинка к вопросу-->
            <!--IsVisible="{Binding IsImageVisible}" показываем картинку только если она есть в json-->
            <Image Source="{Binding QuestionImage}" 
                   HeightRequest="200" 
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsImageVisible}"
                   Margin="0,10"/>

            <!--каждая кнопка привязана к своему варианту ответа из списка AnswerOptions-->
            <!--BackgroundColor меняется в зависимости от того правильный ответ или нет-->
            <!--TextColor становится белым когда фон цветной, чтобы текст было видно-->

            <!--1 вариант ответа-->
            <Button Text="{Binding AnswerOptions[0]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[0]}"
                    BackgroundColor="{Binding Answer0Color}"
                    TextColor="{Binding Answer0TextColor}"
                    WidthRequest="300"
                    BorderWidth="1"
                    BorderColor="DarkGray"
                    HeightRequest="60"
                    LineBreakMode="WordWrap"/>
            <!--LineBreakMode="WordWrap" если текст длинный, переносит на следующую строку-->

            <!--2 вариант ответа-->
            <Button Text="{Binding AnswerOptions[1]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[1]}"
                    BackgroundColor="{Binding Answer1Color}"
                    TextColor="{Binding Answer1TextColor}"
                    WidthRequest="300"
                    BorderWidth="1"
                    BorderColor="DarkGray"
                    HeightRequest="60"
                    LineBreakMode="WordWrap"/>

            <!--3 вариант ответа-->
            <Button Text="{Binding AnswerOptions[2]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[2]}"
                    BackgroundColor="{Binding Answer2Color}"
                    TextColor="{Binding Answer2TextColor}"
                    WidthRequest="300"
                    BorderWidth="1"
                    BorderColor="DarkGray"
                    HeightRequest="60"
                    LineBreakMode="WordWrap"/>

            <!--4 вариант ответа-->
            <Button Text="{Binding AnswerOptions[3]}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding AnswerOptions[3]}"
                    BackgroundColor="{Binding Answer3Color}"
                    TextColor="{Binding Answer3TextColor}"
                    WidthRequest="300"
                    BorderWidth="1"
                    BorderColor="DarkGray"
                    HeightRequest="60"
                    LineBreakMode="WordWrap"/>

            <!--объяснение ответа-->
            <Label Text="{Binding AnswerExplanation}" 
                   FontSize="16"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   Margin="10"/>

            <!--кнопка "Следующая" или "Завершить" если это последний вопрос-->
            <!--текст меняется в ViewModel в зависимости от номера вопроса-->
            <Button Text="{Binding NextButtonText}"
                    Command="{Binding NextQuestionCommand}"
                    WidthRequest="150"
                    Margin="20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
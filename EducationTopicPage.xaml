<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.EducationTopicPage"
             Title="Обучение">
    <ScrollView Orientation="Vertical" >
        <StackLayout>
            <Button Text="Назад"
                    Command="{Binding GoToEducationPageCommand}"
                    Margin="20"/>

            <Label Text="{Binding Title}"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="20"/>

            <VerticalStackLayout x:Name="BlocksContainer" Spacing="10" Margin="20"/>

            <Button Text="Пройти тест"
                    Command="{Binding GoToTestCommand}"
                    Margin="20"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
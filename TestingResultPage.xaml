<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingResultPage"
             Title="Результат теста"
             NavigationPage.HasBackButton="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Button Text="На главную" 
                    Command="{Binding GoToMainCommand}"
                    HorizontalOptions="Start"/>

            <!-- результат в процентах -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,16">
                <Label Text="Вы прошли тест на" 
                       FontSize="20"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding Percent}"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- количество правильных ответов -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,0,0,16">
                <Label Text="Количество правильных ответов" 
                       FontSize="16"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding CorrectCount}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Button Text="Пройти тест заново" 
                    Command="{Binding GoToTestingTopicAgainCommand}"
                    Margin="0,4"/>

            <Button Text="Перейти к изучению следующей темы" 
                    Command="{Binding GoToNextEducationTopicCommand}"
                    Margin="0,4"/>

            <Button Text="Посмотреть статистику по тестам" 
                    Command="{Binding GoToStatisticsCommand}"
                    Margin="0,4"/>

            <Label Text="{Binding BestPercent}" 
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   Margin="0,0,0,16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingResultPage"
             Title="Результат теста"
             NavigationPage.HasBackButton="False">

    <VerticalStackLayout Padding="10" Spacing="20">

        <Button Text="В меню тестов" 
                    Command="{Binding GoToTestingPageCommand}"
                    HorizontalOptions="Start"/>

        <Button Text="Помощь"
                    Command="{Binding OpenHelpCommand}"
                HorizontalOptions="Start"/>

        <HorizontalStackLayout HorizontalOptions="Center" Padding="10" Spacing="20">
            <Label Text="Вы прошли тест на " 
                   VerticalOptions="Center" 
                   FontSize="24"/>
            <Label Text="{Binding Percent}"
                   FontSize="24"
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Padding="10" Spacing="20">
            <Label Text="Количество правильных ответов:" 
                   FontSize="20"/>
            <Label Text="{Binding CorrectCount}"
                   FontSize="20"
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <Button Text="Пройти тест заново" 
                Command="{Binding GoToTestingTopicAgainCommand}"
                Margin="0,0,0,10"
                HorizontalOptions="Center"/>

        <Button Text="Перейти к изучению следующей темы" 
                Command="{Binding GoToNextEducationTopicCommand}"
                Margin="0,0,0,10"
                HorizontalOptions="Center"/>

        <Button Text="Посмотреть статистику по тестам" 
            Command="{Binding GoToStatisticsCommand}"
            Margin="0,0,0,10"
            HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingResultPage"
             Title="Результат теста"
             NavigationPage.HasBackButton="False">

    <VerticalStackLayout Padding="10" Spacing="20">

        <HorizontalStackLayout HorizontalOptions="Center" Padding="10" Spacing="20">
            <Label Text="Вы прошли тест на " 
                   VerticalOptions="Center" 
                   FontSize="24"/>
            <Label Text="{Binding Percent}"
                   FontSize="24"
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Padding="10" Spacing="20">
            <Label Text="Количество правильных ответов:" 
                   FontSize="20"/>
            <Label Text="{Binding CorrectCount}"
                   FontSize="20"
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <Button Text="В меню тестов" 
                Command="{Binding GoToTestingPageCommand}"
                WidthRequest="150"
                HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>
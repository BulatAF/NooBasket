<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.TestingPage"
             x:Name="PageRoot"
             Title="Тестирование">

    <ScrollView Orientation="Vertical" Padding="30">
        <StackLayout>
            <Button Text="Назад" 
                    Command="{Binding GoToMainCommand}"
                    Margin="20"/>

            <!--CollectionView для отображения списка данных, ItemSource в качестве значения принимает коллекцию IEnumerable-->
            <CollectionView ItemsSource="{Binding Topics}">
                <CollectionView.ItemTemplate>
                    <!--свойство ItemsTemplate отвечает за установку шаблона отображения данных-->
                    <DataTemplate>
                        <Button Text="{Binding TitleWithId}" 
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToTestingTopicCommand}"
                                CommandParameter="{Binding .}" 
                                Margin="20"/>
                    </DataTemplate>
                    <!--CommandParameter="{Binding} привязывается к текущему обьекту (данные текущей темы)-->
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NooBasket.ViewModels"
             x:Class="NooBasket.TestingPage"
             x:Name="PageRoot"
             Title="Тестирование">

    <ScrollView Orientation="Vertical" 
                Padding="20"
                HorizontalScrollBarVisibility="Never">
        <StackLayout Spacing="10">

            <Button Text="На главную" 
                    Command="{Binding GoToMainCommand}"
                    HorizontalOptions="Start"/>

            <CollectionView ItemsSource="{Binding Topics}"
                            HorizontalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding TitleWithId}" 
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToTestingTopicCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{Binding ButtonColor}"
                                Margin="0,10"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>
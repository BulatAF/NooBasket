<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NooBasket.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NooBasket"
    Title="NooBasket"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Главная"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Обучение"
        ContentTemplate="{DataTemplate local:EducationPage}"
        Route="EducationPage" />

    <ShellContent
        Title="Тема обучения"
        ContentTemplate="{DataTemplate local:EducationTopicPage}"
        Route="EducationTopicPage" />
    
    <ShellContent
        Title="Тесты"
        ContentTemplate="{DataTemplate local:TestingPage}"
        Route="TestingPage" />

    <ShellContent
        Title="Тестирование темы"
        ContentTemplate="{DataTemplate local:TestingTopicPage}"
        Route="TestingTopicPage" />

    <ShellContent
        Title="Результат"
        ContentTemplate="{DataTemplate local:TestingResultPage}"
        Route="TestingResultPage" />
    
    <ShellContent
        Title="Статистика"
        ContentTemplate="{DataTemplate local:StatisticsPage}"
        Route="StatisticsPage" />

</Shell>
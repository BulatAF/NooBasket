<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NooBasket.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NooBasket"
    Title="NooBasket">

    <ShellContent
        Title="Главная"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Меню тестов"
        ContentTemplate="{DataTemplate local:MenuTests}"
        Route="MenuTests" />
</Shell>

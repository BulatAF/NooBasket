<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NooBasket.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NooBasket"
    Title="NooBasket">

    <ShellContent
        Title="Главная"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Обучение"
        ContentTemplate="{DataTemplate local:EducationPage}"
        Route="EducationPage" />

    <ShellContent
        Title="Тесты"
        ContentTemplate="{DataTemplate local:TestingPage}"
        Route="TestingPage" />

    <ShellContent
        Title="Тема 1"
        ContentTemplate="{DataTemplate local:Topic1Page}"
        Route="Topic1Page" />

    <ShellContent
        Title="Тема 1 Тест"
        ContentTemplate="{DataTemplate local:Topic1TestPage}"
        Route="Topic1TestPage" />

    <ShellContent
        Title="Тема 2"
        ContentTemplate="{DataTemplate local:Topic2Page}"
        Route="Topic2Page" />


</Shell>

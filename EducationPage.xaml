<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NooBasket.ViewModels"
             x:Class="NooBasket.EducationPage"
             x:Name="PageRoot">

    <ScrollView Orientation="Vertical" Padding="30">
        <StackLayout>
            <Button Text="Назад" 
                    Command="{Binding GoToMainCommand}"
                    Margin="20"/>

            <CollectionView ItemsSource="{Binding Topics}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding TitleWithID}" 
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToTopicCommand}"
                                CommandParameter="{Binding .}" 
                                Margin="20"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
    

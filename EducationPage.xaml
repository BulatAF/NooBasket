<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.EducationPage">

    <ScrollView Orientation="Vertical" Padding="30">
        <StackLayout>
            <Button Text="Назад" 
                 Command="{Binding GoToMainCommand}"
                Margin="20"/>

            <Button Text="Тема 1. Общая информация об игре" 
                Command="{Binding GoToTopic1Command}"
                Margin="20"/>

            <Button Text="Тема 2. Площадка" 
                Command="{Binding GoToTopic2Command}"
                Margin="20"/>
        </StackLayout>        
    </ScrollView>
</ContentPage>
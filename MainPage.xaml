<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.MainPage">

    <!-- Grid с 3 строками: верх, растягиваемая середина, низ -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- ВЕРХ: заголовок и две основные кнопки -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" HorizontalOptions="Center">

            <Label Text="Добро пожаловать в NooBasket!" 
                   FontSize="24"
                   HorizontalTextAlignment="Center"
                   Padding="0,0,0,20"/>

            <Button Text="Пройти обучение" 
                    Clicked="OnLearningClicked"
                    Margin="0,5"/>

            <Button Text="Пройти тесты" 
                    Clicked="OnTestsClicked"
                    Margin="0,5"/>
        </VerticalStackLayout>

        <!-- СЕРЕДИНА: пустая, просто расталкивает низ -->
        <!-- Ничего не добавляем -->

        <!-- НИЗ: кнопка поддержки, прижата к низу -->
        <Button Grid.Row="2"
                Text="Обратиться в техподдержку"
                Clicked="OnSupportClicked"
                HorizontalOptions="Center"
                Margin="0,20"/>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.MainPage">
    <FlexLayout Direction="Column" Padding="20">
        <Label Text="Генератор паролей" FontSize="30" HorizontalOptions="Center"/>

        <Label Text="Длина пароля: " />
        <Label Text="{Binding PasswordLenght}" FontSize="20" />
        
        <Stepper  Maximum="16" Minimum="4" Increment="1" Value="{Binding PasswordLenght, Mode=TwoWay}"/>
        
        <Button Text="Сгенерировать парроль" Command="{Binding GeneratePassCommand}"/>

        <Label Text="{Binding Result}" FontSize="30" FontAttributes="Bold"/>
    </FlexLayout>
</ContentPage>

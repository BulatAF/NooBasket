<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NooBasket.MainPage">

    <StackLayout Orientation="Vertical" Padding="30">
        <Label Text="Добро пожаловать в NooBasket!" 
            FontSize="24"
            HorizontalOptions="Center"
               VerticalTextAlignment="Center"
               HorizontalTextAlignment="Center"
               Padding="20"/>

        <Button Text="Пройти обучение" 
                Clicked="OnGoToEducationPage"
                Margin="20"
                />

        <Button Text="Пройти тесты" 
                Clicked="OnGoToTestingPage"
                Margin="20"/>
        
        <Button Text="Обратится в техподдержку"
                HorizontalOptions="End"
                Margin="20"/>
    </StackLayout>

    

</ContentPage>
